    "@types/node": "^26.4.0",
    "@types/rss": "^0.0.32",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "pagefind": "^1.5.2",
    "rss": "^1.2.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.19",
    "vue-tsc": "^3.3.11",
    "zod": "^4.4.2"
  }
